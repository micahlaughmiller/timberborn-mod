<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>TimberbornAI</AssemblyName>
    <RootNamespace>TimberbornAI</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- Game assemblies are not XML-documented and use older patterns. -->
    <NoWarn>CS0436;CS1591</NoWarn>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Point this at your install, e.g.
       D:\SteamLibrary\steamapps\common\Timberborn\Timberborn_Data\Managed
       Update 6+ ships its own mod loader, so no BepInEx/Harmony packages
       are referenced here — this project only needs the game's own
       assemblies to compile against. -->
  <PropertyGroup>
    <GameManaged Condition="'$(GameManaged)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Timberborn\Timberborn_Data\Managed</GameManaged>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- RuntimeInitializeOnLoadMethod pulls in PreserveAttribute, which this
         build ships in its own assembly rather than UnityEngine.CoreModule. -->
    <Reference Include="Unity.Scripting" Condition="Exists('$(GameManaged)\Unity.Scripting.dll')">
      <HintPath>$(GameManaged)\Unity.Scripting.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- If this repo's working tree IS your Timberborn local-mods folder
       (Documents/Timberborn/Mods/TimberbornAI/, clone target for the repo
       root), this drops manifest.json and the built DLL directly into that
       root after every build -- no manual copy step, `git pull` + build is
       enough. Harmless no-op if you build from a separate dev checkout;
       just delete this target in that case. -->
  <Target Name="CopyToModRoot" AfterTargets="Build">
    <ItemGroup>
      <ModRootFiles Include="$(MSBuildProjectDirectory)\manifest.json" />
      <ModRootFiles Include="$(TargetPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(ModRootFiles)" DestinationFolder="$(MSBuildProjectDirectory)\.." SkipUnchangedFiles="true" />
  </Target>

</Project>
