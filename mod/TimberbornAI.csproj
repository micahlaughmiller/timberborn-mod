<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>TimberbornAI</AssemblyName>
    <RootNamespace>TimberbornAI</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- Game assemblies are not XML-documented and use older patterns. -->
    <NoWarn>CS0436;CS1591</NoWarn>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Point this at your install, e.g.
       D:\SteamLibrary\steamapps\common\Timberborn\Timberborn_Data\Managed
       Update 6+ ships its own mod loader, so no BepInEx/Harmony packages
       are referenced here — this project only needs the game's own
       assemblies to compile against. -->
  <PropertyGroup>
    <GameManaged Condition="'$(GameManaged)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Timberborn\Timberborn_Data\Managed</GameManaged>
  </PropertyGroup>

  <!-- Reference every game assembly we might touch. Compiling against one DLL at a
       time meant a CS0012 "assembly not referenced" error per missing module. -->
  <ItemGroup>
    <GameReference Include="$(GameManaged)\Timberborn.*.dll" />
    <GameReference Include="$(GameManaged)\Bindito.*.dll" />
    <GameReference Include="$(GameManaged)\UnityEngine*.dll" />
    <!-- Specs expose ImmutableArray<T>; the game ships this assembly alongside its own. -->
    <GameReference Include="$(GameManaged)\System.Collections.Immutable.dll" />
    <Reference Include="@(GameReference)">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Deploy step. Pass -p:ModInstallDir="<path to Documents/Timberborn/Mods/TimberbornAI>"
       and every build copies exactly manifest.json and the DLL there. Keep the git
       clone OUTSIDE the game's Mods folder: the game scans mod subfolders, and a
       clone brings .git, bin and obj with it (slow, especially inside OneDrive).
       With ModInstallDir unset this target does nothing. -->
  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(ModInstallDir)' != ''">
    <MakeDir Directories="$(ModInstallDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\manifest.json;$(TargetPath)" DestinationFolder="$(ModInstallDir)" />
    <Message Importance="high" Text="Deployed manifest.json and TimberbornAI.dll to $(ModInstallDir)" />
  </Target>

</Project>
